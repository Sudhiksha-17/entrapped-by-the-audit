# Copy to .env and fill in. Never commit .env.
# Only the keys for the model providers you actually use are required.
# Routing used by the simulation (third_party/llm-agent-collusion/src/continuous_double_auction/util/misc.py:10-26, get_client):
#   model name starts with "gpt"    -> OpenAI      (OPENAI_API_KEY)
#   model name starts with "claude" -> Anthropic   (ANTHROPIC_API_KEY)
#   model name starts with "gemini" -> Vertex AI   (GOOGLE_PROJECT_ID plus Google application default credentials)
#   anything else                   -> ValueError. ExperimentParams also only accepts 9 whitelisted model strings (cda_types.py:6-11).
# OpenRouter (OPENROUTER_API_KEY) exists in model_wrappers.py but is not reachable through get_client.
# Upstream's end-of-episode LLM judge uses gpt-4.1-mini (evaluate.py:17-23), so running upstream
# simulation.py unmodified needs OPENAI_API_KEY even when no agent uses OpenAI.

OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GOOGLE_PROJECT_ID=
OPENROUTER_API_KEY=

# Upstream simulation.py calls wandb.init(entity="spar-llm-collusion") at the end of every episode.
# Keep this disabled so nothing is sent to the upstream authors' W&B entity.
# Verified in Phase 1: no mode, settings or key is passed in code, so this env var takes effect.
WANDB_MODE=disabled
